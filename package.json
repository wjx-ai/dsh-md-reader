{
  "name": "dsh-md-reader",
  "version": "1.2.2",
  "description": "DSH Markdown 阅读插件：点击会话中的 MD/图片文件链接时，在浏览器右侧「详情栏」内以真正的三栏布局（侧边栏 | 会话区 | MD 文档）直接渲染阅读，而不是交给系统默认程序。目录 TOC、复制原文、字号缩放、自动跟随磁盘变更、图片内联预览。双半身插件：宿主半身提供只读 HTTP 路由，浏览器半身拦截点击并渲染面板。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "reader",
    "preview",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjx-ai/dsh-md-reader.git"
  },
  "homepage": "https://github.com/wjx-ai/dsh-md-reader#readme",
  "bugs": "https://github.com/wjx-ai/dsh-md-reader/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "immediately": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
